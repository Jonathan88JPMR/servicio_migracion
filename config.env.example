# Plantilla exclusiva de produccion; no coloque la contrasena SQL aqui.
# SQL_PASSWORD se obtiene de una variable protegida de Windows.
# config.env esta excluido de Git.
MODO_SERVICIO=PRODUCCION
HABILITAR_PRODUCCION=NO
SQL_USER=usr_migracion_adjuntos
SERVIDOR_MS_HASS=172.16.20.25
BD_MS_HASS=MS_HASS_PROVEEDOR
SERVIDOR_SPRING=172.16.20.24
BD_SPRING_PRODUCCION=HP_SPRING_PRD
RUTA_RAIZ_PRODUCCION=\\172.16.20.24\SpringGestionDoc\PROD
# Solo se migran documentos con fecha de orden/documento dentro del rango
# [FECHA_MINIMA, FECHA_MAXIMA]. 'TODOS' desactiva cada limite por separado.
# FECHA_MINIMA vacia = 2026-01-01; FECHA_MAXIMA vacia = sin limite.
# Ej. solo setiembre 2026:
FECHA_MINIMA=2026-09-01
FECHA_MAXIMA=2026-09-30
TABLA_ADJUNTOS=MS_Archivo
USUARIO_MIGRACION=MIGRACION
