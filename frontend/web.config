<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <handlers>
      <add name="PythonHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform
      processPath="C:\Python\python.exe"
      arguments="server.py"
      startupTimeLimit="60"
      requestTimeout="00:10:00"
      stdoutLogEnabled="true"
      stdoutLogFile="C:\inetpub\logs\servicio_documentos\stdout.log">
    </httpPlatform>
  </system.webServer>
</configuration>